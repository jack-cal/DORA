<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#416FFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F6F9FC</item>
        <item name="android:navigationBarColor">#F6F9FC</item>
        <item name="android:windowBackground">#F6F9FC</item>
    </style>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#417DFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F6F9FC</item>
        <item name="android:navigationBarColor">#F6F9FC</item>
        <item name="android:windowBackground">#F6F9FC</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#68A2FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#07121F</item>
        <item name="android:navigationBarColor">#07121F</item>
        <item name="android:windowBackground">#07121F</item>
    </style>
